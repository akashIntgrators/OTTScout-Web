# Set the real key as a GitHub Actions secret; never commit it.
STREAMING_API_KEY=
# direct: key from developers.movieofthenight.com; rapidapi: key from RapidAPI
STREAMING_API_MODE=direct
# Conservative application limits; confirm the actual provider plan before changing.
MONTHLY_REQUEST_LIMIT=400
RUN_REQUEST_LIMIT=12

# Server-side TMDB metadata enrichment; separate from streaming API limits.
TMDB_READ_ACCESS_TOKEN=
TMDB_RUN_REQUEST_LIMIT=300
